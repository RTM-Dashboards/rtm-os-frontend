// RTM OS — Prisma Schema
//
// Provider: PostgreSQL (Supabase)
// Connection: DATABASE_URL is configured in prisma.config.ts (Prisma 7+).
//             For local dev, set DATABASE_URL in .env or .env.local.
//             For production, set DATABASE_URL in Vercel environment variables.
//
// Scope of this migration (Phase 1):
//   - Lead       → was data/leads.json
//   - LeadStatus → was data/leads-status.json
//   - Opportunity → was data/sales-opportunities.json
//
// All other data/*.json stores remain file-backed (future migration phases).
//
// Sub-objects (ghl, audit, proposal, handoff, affiliate, communicationLog) and
// array fields on Opportunity are stored as Json columns — pragmatic for Phase 1,
// avoids 12+ relational tables while still persisting all data correctly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Lead ──────────────────────────────────────────────────────────────────────
// Maps 1:1 to LeadRecord in data/leads.json.
// String arrays (ghlContactTags, businessGoals, painPoints, requestedServices)
// stored as PostgreSQL text arrays.

model Lead {
  // Primary key — matches the app's string id (e.g. "L001", "LGHL1234567890")
  id                    String   @id

  // Core contact fields
  name                  String   @default("")
  businessName          String   @default("")
  industry              String   @default("")
  website               String   @default("")
  email                 String   @default("")
  phone                 String   @default("")
  location              String   @default("")

  // GHL integration fields
  ghlContactId          String   @default("")
  ghlAssignedUser       String   @default("")
  ghlSource             String   @default("")
  ghlCreatedDate        String   @default("")
  ghlLastActivityDate   String   @default("")
  ghlContactTags        String[]   @default([])
  ghlContactStatus      String   @default("")
  ghlSyncStatus         String   @default("")
  ghlOrigin             Boolean  @default(false)
  ghlLastSyncedAt       String?
  ghlSyncError          String?

  // RTM qualification fields
  leadSource            String   @default("")
  assignedRep           String   @default("")
  stage                 String   @default("New Lead")
  discoveryScheduled    Boolean  @default(false)
  discoveryDate         String   @default("")
  discoveryNotes        String   @default("")

  // BANT / discovery arrays
  businessGoals         String[]   @default([])
  painPoints            String[]   @default([])
  requestedServices     String[]   @default([])
  budget                String   @default("Unknown")
  authority             String   @default("Unknown")
  need                  String   @default("Low")
  timeline              String   @default("6+ months")

  // Value & attribution
  estimatedValue        Int      @default(0)
  affiliateName         String   @default("—")

  // Display / human dates (kept as strings to match original JSON)
  createdDate           String   @default("")
  lastActivity          String   @default("")
  notes                 String   @default("")

  // Disqualification
  disqualified          Boolean  @default(false)
  disqualifiedReason    String?

  // Audit timestamps (ISO-8601 strings)
  createdAt             String   @default("")
  updatedAt             String   @default("")

  @@map("leads")
}

// ── LeadStatus ────────────────────────────────────────────────────────────────
// Maps 1:1 to LeadStatusRecord in data/leads-status.json.
// Stores field-level overrides driven by UI actions and GHL sync.
// Keyed by leadId (not a foreign-key constraint so orphaned overlays don't break).

model LeadStatus {
  leadId              String   @id

  // Overridable lead fields
  stage               String?
  assignedRep         String?
  discoveryScheduled  Boolean?
  discoveryDate       String?
  discoveryNotes      String?
  notes               String?
  disqualified        Boolean?
  disqualifiedReason  String?

  // Editable core fields
  name                String?
  businessName        String?
  industry            String?
  leadSource          String?
  website             String?

  // GHL sync state — written by /api/ghl/sync-lead, never by client directly
  ghlContactId        String?
  ghlSyncStatus       String?
  ghlSyncError        String?
  ghlLastSyncedAt     String?

  // Loop-prevention: timestamp of the last RTM→GHL stage tag push.
  // Incoming GHL webhook stage changes are ignored when this is < 30 s ago,
  // preventing echo loops from our own outbound tag writes firing back.
  ghlLastStagePushedAt String?

  // Audit
  updatedAt           String   @default("")

  @@map("lead_statuses")
}

// ── Opportunity ───────────────────────────────────────────────────────────────
// Maps 1:1 to OpportunityRecord in data/sales-opportunities.json.
//
// Scalar fields are columns; complex nested objects and arrays are Json columns.
// This avoids 10+ relational tables while keeping all data correctly persisted
// and queryable enough for Phase 1 (full list fetches + single-record upserts).
//
// Json column contents are validated by the app layer (TypeScript types),
// not by the database.

model Opportunity {
  // Primary key — matches app's string id (e.g. "opp-mock-001", "O001")
  id                    String   @id

  opportunityNumber     String   @default("")
  leadId                String?
  clientName            String   @default("")
  businessName          String   @default("")
  tradeType             String   @default("")
  contactName           String   @default("")
  contactPhone          String   @default("")
  contactEmail          String   @default("")
  leadSource            String   @default("")
  assignedRep           String   @default("")
  stage                 String   @default("")
  priority              String   @default("")
  estimatedMonthlyValue Float    @default(0)
  expectedCloseDate     String   @default("")

  // Array of strings — service interest tags
  serviceInterest       String[]   @default([])

  discoveryNotes        String   @default("")

  // Top-level GHL shorthand fields (also reflected in ghl Json)
  ghlContactId          String   @default("")
  ghlSynced             Boolean  @default(false)

  // Optional extended scalar fields (present on newer records)
  industry              String?
  website               String?
  primaryContact        String?
  email                 String?
  phone                 String?
  affiliateSource       String?
  estimatedValue        Float?
  monthlyValue          Float?
  contractLength        String?
  probability           Float?
  daysInStage           Int?
  nextAction            String?
  closingMonth          String?
  opportunityScore      Float?
  forecastMonth         String?
  forecastQuarter       String?
  activeWizardId        String?
  intakeRecord          Json?

  // ── Json sub-objects ────────────────────────────────────────────────────────
  // These preserve the exact nested structure expected by the frontend.
  // Shape docs are in the field comments; enforced by TypeScript, not DB.

  // ghl: KanbanGhlFields — ghlOpportunityId, ghlContactId, ghlPipelineId, etc.
  ghl                   Json?

  // audit: { status, assignedAuditor, dueDate, findingsSummary }
  audit                 Json?

  // proposal: { status, proposalValue, sentDate, viewedDate, approvalStatus }
  proposal              Json?

  // handoff: { status, billingRequestStatus, invoiceStatus, activationStatus }
  handoff               Json?

  // affiliate: { affiliateName, referralSource, referralCode, commissionModel,
  //              potentialCommission, revenueAttribution }
  affiliate             Json?

  // communicationLog: { opportunityId, entries: CommunicationEntry[] }
  communicationLog      Json?

  // ── Json array fields ───────────────────────────────────────────────────────
  // Stored as Json (not String[]) because each item is an object, not a scalar.

  // followUps: FollowUpItem[] — { id, subject, dueDate, status, owner }
  followUps             Json?

  // tasks: TaskItem[] — { id, title, status, owner, dueDate }
  tasks                 Json?

  // notifications: NotificationItem[] — { id, type, message, date, read }
  notifications         Json?

  // workflowEvents: WorkflowEvent[] — { step, completedAt, completedBy, notes }
  workflowEvents        Json?

  // recentActivities: ActivityItem[] — { date, type, user, notes }
  recentActivities      Json?

  // notes: NoteItem[] — { date, author, note, category }
  // Note: JSON array of note objects, distinct from Lead.notes (plain string)
  notes                 Json?

  // nextSteps: NextStepItem[] — { action, owner, dueDate, priority }
  nextSteps             Json?

  // Audit timestamps
  createdAt             String   @default("")
  updatedAt             String   @default("")

  @@map("opportunities")
}

// ── GhlWebhookLog ──────────────────────────────────────────────────────────────────────────────
// Raw inbound GHL webhook payload capture.
//
// Every POST to /api/ghl/webhook is recorded here BEFORE any processing so
// that the original payload is never lost.  A write failure is non-fatal and
// cannot block lead ingestion.
//
// Postgres only — Vercel's serverless filesystem is read-only so a JSON-file
// approach silently discards every payload in production.

model GhlWebhookLog {
  // Auto-incremented surrogate key; no business meaning
  id              Int      @id @default(autoincrement())

  // Wall-clock timestamp when the webhook was received (ISO-8601)
  receivedAt      String

  // Full raw request body exactly as received, before any parsing or normalisation
  rawPayload      Json

  // GHL Contact ID resolved from the payload (empty string when unresolvable)
  ghlContactId    String   @default("")

  // RTM Lead id created or updated as a result of this webhook (null when skipped)
  leadId          String?

  // Outcome of processing this webhook
  // Values: "created" | "updated" | "skipped" | "error"
  outcome         String   @default("")

  // Human-readable detail about the outcome (e.g. error message, skip reason)
  outcomeDetail   String   @default("")

  @@map("ghl_webhook_logs")
}


// ── User ──────────────────────────────────────────────────────────────────────
// Mirrors auth.users (managed by Supabase Auth, outside Prisma's schema).
//
// WHY A MIRROR: Prisma cannot introspect or migrate the Supabase auth schema.
// Any join or filter on user identity would need raw SQL. Department and role
// must live in a Prisma table regardless. The auth.users UUID is stored here
// as the primary key so the two records are always in sync with no FK constraint
// that would break when auth.users entries change outside Prisma.
//
// Populated by the OAuth callback (app/auth/callback/route.ts) via upsert.
// A failed upsert is non-fatal — the user may sign in successfully even if this
// row is absent; it will be created on the next successful sign-in.
//
// Timestamps follow the existing schema convention: ISO-8601 strings, not
// DateTime columns. (See Lead.createdAt, Opportunity.createdAt above.)

model User {
  // Primary key — the same UUID as auth.users.id (Supabase Auth)
  id          String   @id

  email       String   @unique
  name        String

  // Optional profile fields — populated as the team grows into role management
  department  String?

  // Role and access control
  // Allowed values (enforced server-side in lib/auth/): "SystemAdmin" | "Executive" | "Manager" | "Member"
  // null means no role has been assigned yet; access is denied until a role is set.
  role        String?

  // Account lifecycle status.
  // Allowed values (enforced server-side in lib/auth/): "pending" | "active" | "disabled"
  // New rows default to "pending". Access requires status = "active".
  status      String   @default("pending")

  // Invite provenance — nullable until the invite system is built.
  // invitedBy: the User.id of whoever sent the invite (null for the seed SystemAdmin).
  invitedBy   String?
  // invitedAt: ISO-8601 string, set when the invite was created.
  invitedAt   String?

  // Role/status/department audit trail — set by PATCH /api/users on every change.
  // roleSetBy: the User.id of the person who made the change.
  // roleSetAt: ISO-8601 string of when the change was made.
  roleSetBy   String?
  roleSetAt   String?

  // Set on every successful login by the auth callback.
  // Will power the "Last Active" column on the Team Members page.
  lastLoginAt String?

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt   String   @default("")
  updatedAt   String   @default("")

  @@map("users")
}
// ── PipelineStage ─────────────────────────────────────────────────────────────
// Replaces data/pipeline-stages.json as the persistence layer for the
// pipeline stage configuration editor at /settings/pipeline-config.
//
// GET  /api/pipeline-stages  reads this table.
// POST /api/pipeline-stages  replaces all rows in this table.
//
// Postgres only — Vercel's serverless filesystem is read-only so the previous
// JSON-file approach silently discarded every write in production.
//
// Seeded from DEFAULT_PIPELINE_STAGES in lib/sales/pipeline-stages.ts
// (the canonical 11-stage list). data/pipeline-stages.json is NOT the seed
// source: it contains stale entries (Lead, Discovery, Qualified) that were
// deliberately removed from the canonical list.

model PipelineStage {
  // Business-meaningful string id matching the app's stage-N convention.
  // Assigned by the editor; not auto-generated by the database.
  id      String   @id

  name    String
  order   Int
  color   String   @default("")
  bg      String   @default("")
  border  String   @default("")

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt  String   @default("")
  updatedAt  String   @default("")

  @@map("pipeline_stages")
}

// ── LeadStage ────────────────────────────────────────────────────────────────
// Replaces the compile-time LEAD_STAGES / STAGE_CONFIG constants in
// app/(sales)/sales/leads/page.tsx as the persistence layer for the lead
// stage list.
//
// GET  /api/lead-stages  reads this table (ordered by `order` asc).
// POST /api/lead-stages  replaces all rows atomically.
//
// Postgres only — Vercel's serverless filesystem is read-only.
//
// Seeded from DEFAULT_LEAD_STAGES in lib/sales/lead-stages.ts
// (the canonical 7-stage list).

model LeadStage {
  // Business-meaningful string id, e.g. "lead-stage-1".
  // Assigned by the editor; not auto-generated by the database.
  id      String   @id

  name    String
  order   Int
  color   String   @default("")
  bg      String   @default("")
  border  String   @default("")

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt  String   @default("")
  updatedAt  String   @default("")

  @@map("lead_stages")
}

// ── KpiDefinition ─────────────────────────────────────────────────────────────
// Replaces data/kpi-definitions.json as the persistence layer for the KPI
// visibility settings editor (KpiSettingsSection / /settings/kpi-definitions).
//
// GET   /api/kpi-definitions  reads this table.
// PATCH /api/kpi-definitions  updates a single row's enabled flag.
//
// Postgres only — same read-only filesystem constraint as pipeline stages.
//
// Seeded from data/kpi-definitions.json, preserving all fields including the
// enabled state (those toggles may reflect real decisions).
//
// departments is stored as a String[] (Postgres text array) — same pattern
// as Lead.ghlContactTags, Lead.businessGoals, etc.

// ── Proposal ─────────────────────────────────────────────────────────────────
// Maps 1:1 to SalesProposalRecord in data/sales-proposals.json.
//
// Scalar fields that are queried or filtered are real columns.
// Nested objects and arrays that are always read/written as a whole are Json?
// columns — the same pattern used by Opportunity for its sub-objects.
//
// The index signature [key: string]: unknown on SalesProposalRecord allows
// arbitrary extra wizard fields (e.g. wizardId, linkedOpportunityId). Those
// extras are captured in extraFields Json? so no data is dropped.
//
// Postgres only — Vercel's serverless filesystem is read-only so the previous
// JSON-file approach silently discarded every write in production.

model Proposal {
  // Primary key — matches the app's string id (UUID or wizard-prefixed string)
  id                              String   @id

  // Status enum values as defined in SalesProposalRecord
  // "draft" | "in-progress" | "sent" | "accepted" | "rejected" | "complete"
  status                          String   @default("draft")

  // Foreign-key references (no FK constraint — orphaned records must not break)
  opportunityId                   String?
  leadId                          String?

  // Wizard navigation scalars
  currentStep                     Int      @default(1)

  // Steps completed by the wizard user (array of step numbers)
  completedSteps                  Int[]    @default([])

  // Goal slugs selected by the user (flat string array)
  selectedGoals                   String[] @default([])

  // Audit mode and id selection
  auditMode                       String?
  selectedAuditId                 String?

  // Recommendation slugs approved by the user
  approvedRecommendations         String[] @default([])
  approvedRecommendationServiceNames String[] @default([])

  // Discount percentage scalar (the rest of discount lives in discount Json)
  discountPercentage              Float    @default(0)

  // Pre-seeded audit context from the URL that opened the wizard
  preselectedAuditId              String?
  preselectedAuditType            String?

  // ── Json columns ────────────────────────────────────────────────────────────
  // These preserve the exact nested structure expected by the frontend.
  // Shape is enforced by TypeScript, not the database.

  // clientInfo: { name, businessName, industry, location, website, leadSource,
  //               contactName, contactEmail, contactPhone, notes }
  clientInfo                      Json?

  // auditResult: unknown — may be IntakeAuditResult, AiAuditResult, or null
  auditResult                     Json?

  // lineItems: unknown[] — ProposalLineItemRow[] or wizard intermediate format
  lineItems                       Json?

  // discount: ProposalDiscount — { type, value, label, authorizationNote }
  discount                        Json?

  // budgetResult: BudgetOptimizerOutput or null
  budgetResult                    Json?

  // proposalDocument: unknown — rendered proposal sections
  proposalDocument                Json?

  // intakeRecord: Partial<HomeServicesIntakeRecord> or null
  intakeRecord                    Json?

  // aiAuditResult: AiAuditResult or null
  aiAuditResult                   Json?

  // ── Arbitrary extra wizard fields ───────────────────────────────────────────
  // Captures the [key: string]: unknown index signature on SalesProposalRecord.
  // e.g. wizardId, linkedOpportunityId. Stored as a single Json object.
  extraFields                     Json?

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  lastSavedAt                     String?
  sentAt                          String?
  createdAt                       String   @default("")
  updatedAt                       String   @default("")

  @@map("proposals")
}

model KpiDefinition {
  // Stable slug id assigned at definition time (e.g. "content-pages-published").
  id          String    @id

  name        String
  // "Campaign" | "People" — matches the KpiDefinition type in route.ts
  category    String
  // dept slugs, or ["all"] for universal People KPIs
  departments String[]
  enabled     Boolean   @default(true)
  description String    @default("")

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt   String    @default("")
  updatedAt   String    @default("")

  @@map("kpi_definitions")
}

// ── Client ────────────────────────────────────────────────────────────────────
// The paying owner. A Client holds one or more Businesses (domains).
//
// CLIENT IS THE OWNER, not the billing unit. Billing is per Business (domain),
// so invoice status, payment status and subscription state live on Business,
// not here.
//
// A Client is created by the Billing flow when a payment is confirmed. A
// payment that is pending or failed is a valid state; the schema supports it
// via paymentStatus on the Business that was being activated.
//
// GHL's role ends at payment. ghlContactId is provenance only — it records
// which GHL contact originated this client. It is NOT an identity key and
// NOT a matching key. No GHL lookup or sync is built on this field.

model Client {
  // Caller-assigned string id (e.g. UUID). Follows the pattern of all other
  // models in this schema: String @id, no database-generated default.
  id              String   @id

  // Identity and contact details
  fullName        String   @default("")
  email           String   @default("")
  phone           String   @default("")
  company         String   @default("")

  // Internal relationship ownership
  assignedAM      String   @default("")   // account manager name or id

  // Provenance: the GHL contact this client was created from.
  // NOT an identity key. NOT a matching key. Records origin only.
  // Do not build any GHL lookup or sync against this field.
  ghlContactId    String?

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt       String   @default("")
  updatedAt       String   @default("")

  @@map("clients")
}

// ── Business ──────────────────────────────────────────────────────────────────
// A domain is the identity. One website = one Business.
// Billing is per Business, not per Client. Each Business gets its own invoice.
//
// DOMAIN STORAGE: stored normalised — no scheme, no www prefix, no trailing
// slash, lowercased. "company-a.com", never "https://www.Company-A.com/".
// The API routes normalise every input via lib/clients/domain.ts before
// writing or querying.
//
// DOMAIN UNIQUENESS: unique per Client, not globally. The same domain can
// legitimately appear under two different Clients — acquisition scenarios,
// reseller arrangements, or a domain changing hands. A global unique constraint
// would block those cases. Scoping to (clientId, domain) allows them while
// still preventing one client from duplicating their own domain.
//
// GHL provenance: ghlOpportunityId records which GHL opportunity led to this
// business being activated. NOT an identity key. NOT a matching key.

model Business {
  // Caller-assigned string id (e.g. UUID).
  id                  String   @id

  // Domain is the primary identity. Stored normalised (see above).
  // Globally unique: one website = one Business, agency-wide.
  domain              String   @unique
  displayName         String   @default("")

  // Owner — plain string column, no FK constraint (matches codebase pattern).
  clientId            String

  // ── Billing state (per domain, not per client) ─────────────────────────────
  // CACHED SUMMARY — these four fields mirror the most recent Invoice for this
  // Business. They are written ONLY by the invoice status path (POST and PATCH
  // /api/invoices via syncBusinessCachedSummary). Do NOT write them directly
  // from any other handler or page; doing so breaks the "Invoice is authoritative"
  // rule established in Phase C.
  //
  // Invoice and payment status for THIS domain's subscription.
  // Valid invoiceStatus values: "none" | "pending" | "sent" | "paid" | "overdue" | "cancelled"
  // Valid paymentStatus values: "none" | "awaiting" | "failed" | "confirmed"
  invoiceStatus       String   @default("none")
  paymentStatus       String   @default("none")
  invoiceAmountCents  Int      @default(0)     // amount in cents to avoid float rounding
  subscriptionRef     String?                 // external subscription id (e.g. Stripe)

  // Cancellation lifecycle for this business (domain).
  // String, not enum — values can be extended without a schema migration.
  // Valid values: "None" | "Requested" | "In Review" | "Approved" | "Cancelled"
  cancellationStatus  String   @default("None")

  // Billing closure status for this business (domain).
  // String, not enum — values can be extended without a schema migration.
  // Valid values: "Pending" | "Paid" | "Overdue" | "Cleared" | "Closed"
  billingStatus       String   @default("Pending")

  // ── Delivery and activation state ──────────────────────────────────────────
  // Valid activationStatus values: "inactive" | "pending" | "active" | "suspended"
  // Valid onboardingStatus values: "not_started" | "in_progress" | "complete"
  assignedAM          String   @default("")   // account manager for this business
  activationStatus    String   @default("inactive")
  onboardingStatus    String   @default("not_started")
  activeServices      String[]              // list of service slugs currently active
  monthlyValueCents   Int      @default(0)   // monthly recurring value in cents
  renewalDate         String?               // ISO-8601 string, nullable until set
  // Valid renewalStatus values: "ok" | "upcoming" | "overdue" | "cancelled"
  renewalStatus       String   @default("ok")

  // ── AM delivery lifecycle ────────────────────────────────────────────────────
  // cleared: Billing's payment verification gate. Set to true by Billing after
  // payment is confirmed and the client is ready for AM handoff. AM pages gate
  // their activation workflow on this flag. Billing-owned; AM reads only.
  cleared             Boolean  @default(false)

  // kickoffCompleted: true once the AM has run the kickoff call with the client.
  // Written by AM via the onboarding record flow.
  kickoffCompleted    Boolean  @default(false)

  // kickoffDate: ISO-8601 date string of when the kickoff call occurred.
  // Nullable until the kickoff call is completed.
  kickoffDate         String?                  // ISO-8601 date string, nullable until set

  // assignedAt: ISO-8601 timestamp of the most recent AM assignment or reassignment.
  // Nullable until first assignment. Written by AM pages alongside assignedAM.
  //
  // TODO: automatic workload-based AM assignment with manager override is the
  // intended future behaviour. It is blocked on the User model gaining populated
  // department and role fields so that workload can be computed per-AM and the
  // assigning manager can be verified. Until that lands, assignedAM is manual.
  assignedAt          String?                  // ISO-8601 string, nullable until set

  // Provenance: the GHL opportunity this business was created from.
  // NOT an identity key. NOT a matching key. Records origin only.
  // Do not build any GHL lookup or sync against this field.
  ghlOpportunityId    String?

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt           String   @default("")
  updatedAt           String   @default("")

  // Domain is globally unique: one website = one Business, agency-wide.
  // A global @unique on domain replaces the former @@unique([clientId, domain]).
  // clients and businesses were both at 0 rows at migration time; no backfill.
  // Index clientId for fast "all businesses for a client" queries.
  @@index([domain])
  @@index([clientId])
  @@map("businesses")
}

// ── PointOfContact ────────────────────────────────────────────────────────────
// A named contact attached to a Business. Multiple contacts per business,
// each with a role describing how they interact with RTM.
//
// Role is a plain String, not an enum, so new roles can be added without a
// schema migration. Expected values:
//   "Owner"      — the business owner or primary decision-maker
//   "Marketing"  — marketing team contact
//   "Billing"    — accounts payable / invoice recipient
//   "Technical"  — technical or web team contact
//   "Other"      — any other role not listed above

model PointOfContact {
  // Caller-assigned string id.
  id          String   @id

  // Parent business — plain column, no FK constraint.
  businessId  String

  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")

  // See role values in the comment above.
  role        String   @default("Other")

  // Whether this is the primary contact to reach for this business.
  isPrimary   Boolean  @default(false)

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt   String   @default("")
  updatedAt   String   @default("")

  @@index([businessId])
  @@map("points_of_contact")
}

// ── Project ───────────────────────────────────────────────────────────────────
// A unit of work attached to a Business (domain).
//
// This model does NOT attempt to replicate the existing engine project shape.
// That shape was built for a mock-data model that is being discarded.
// This model captures what a project needs at the data layer:
//   - name and what service it delivers
//   - who owns it internally
//   - lifecycle status and dates
//   - any structured deliverable data stored as a whole (Json?)
//
// INCLUDED:
//   name, service, status, assignedAM, startDate, endDate — scalar fields that
//   are queried or filtered individually.
//   deliverables Json? — structured deliverable or scope data read/written as a
//   whole; avoids premature normalisation of a shape that is still evolving.
//
// EXCLUDED:
//   The 30+ fields on the mock engine project record (seoData, analyticsData,
//   contentCalendar, adCampaigns, etc.). Those were mock-only fields with no
//   real data behind them. They belong to a future domain-specific model once
//   the real requirements are understood.
//
// Valid status values:
//   "planned" | "active" | "on_hold" | "complete" | "cancelled"

model Project {
  // Caller-assigned string id.
  id            String   @id

  // Parent business — plain column, no FK constraint.
  businessId    String

  name          String   @default("")

  // The service this project delivers (e.g. "SEO", "PPC", "Web Design").
  service       String   @default("")

  // See valid status values in the comment above.
  status        String   @default("planned")

  // Internal owner of this project.
  assignedAM    String   @default("")

  // ISO-8601 strings, nullable until set.
  startDate     String?
  endDate       String?

  // Structured deliverable or scope data, read/written as a whole.
  // Shape is enforced by the application layer, not the database.
  deliverables  Json?

  // Audit timestamps — ISO-8601 strings, matching existing model conventions
  createdAt     String   @default("")
  updatedAt     String   @default("")

  @@index([businessId])
  @@map("projects")
}

// ── SalesHandoff ──────────────────────────────────────────────────────────────
// Postgres persistence for the Sales→Billing handoff record.
//
// Round-trips every field on HandoffRecord (lib/sales/handoff-engine.ts).
// Complex sub-objects (checklist, summaryFields) are stored as Json columns.
// Timestamps on this model follow the existing schema convention: ISO-8601
// strings, not DateTime columns.
//
// Four typed billing columns are populated from summaryFields on every write
// by lib/billing/handoff-summary-parser.ts. summaryFields remains the source
// of truth for display; the typed columns are for Billing queries/logic.

model SalesHandoff {
  // Caller-assigned string id (e.g. "hof-seed-0041", "hof-${Date.now()}-${random}")
  id                    String   @id

  handoffNumber         String   @default("")
  clientName            String   @default("")
  contractNumber        String   @default("")
  contractId            String   @default("")
  preparedBy            String   @default("")

  // ISO-8601 string, follows existing String timestamp convention
  createdAt             String   @default("")

  // HandoffActivationStatus: "not-started"|"in-progress"|"ready"|"submitted"|"received"
  status                String   @default("not-started")

  // HandoffChecklistEntry[] — stored as Json, read/written as a whole
  checklist             Json     @default("[]")

  // Record<string, string> — stored as Json
  summaryFields         Json     @default("{}")

  completionPercentage  Int      @default(0)
  readyToSubmit         Boolean  @default(false)

  // Optional ISO-8601 strings
  submittedAt           String?
  receivedBy            String?

  submittedToBilling    Boolean  @default(false)
  submittedToBillingAt  String?

  processed             Boolean  @default(false)
  processedAt           String?
  processedClientId     String?

  // ── Typed billing columns ─────────────────────────────────────────────────
  // Populated by lib/billing/handoff-summary-parser.ts on every POST/PATCH.
  // NULL means the value is missing, malformed, or Billing must enter manually.
  // summaryFields is the display source of truth; these are for queries/logic.

  // Parsed from summaryFields["monthly-recurring-revenue"], e.g. "$3,800/mo" → 380000
  monthlyValueCents     Int?

  // Parsed from summaryFields["setup-fees"], e.g. "$0" → 0
  setupFeeCents         Int?

  // Parsed from summaryFields["payment-terms"], e.g. "Net 15" → "Net 15"
  paymentTerms          String?

  // Parsed from summaryFields["term-length"], leading integer e.g. "12 months" → 12
  termLengthMonths      Int?

  // ── Contact and domain fields (carried from the originating contract) ────────────
  // All nullable: rows created before this migration, or from contracts without
  // a website, must not break. Billing sees null and can fill manually.

  // Normalised domain (no scheme, no www, no trailing slash, lowercased).
  // Carried from SalesContractRecord.domain via RequestInvoiceButton.
  domain                String?

  // Contact person (not the business name). From clientInfo.contactName.
  contactName           String?

  // From clientInfo.contactEmail.
  contactEmail          String?

  // From clientInfo.contactPhone.
  contactPhone          String?

  // Total contract value in cents: (monthly * termMonths) + setup.
  // Null when either monthly or term is unknown.
  contractAmountCents   Int?

  // Billing queue filters: submittedToBilling, processed
  @@index([submittedToBilling])
  @@index([processed])
  @@index([contractId])
  @@map("sales_handoffs")
}

// ── Invoice ───────────────────────────────────────────────────────────────────
// One invoice document. One Business accumulates many Invoices over time.
//
// Invoice dates are real DateTime columns — the first DateTime in this schema.
// (Business and Client timestamps remain String per the existing convention.)
//
// invoiceNumber is globally unique, server-generated in a transaction using a
// Postgres advisory lock. The client never supplies invoiceNumber.
// Format: INV-XXXX, zero-padded to 4+ digits, seeded at INV-0064.
//
// salesHandoffId is nullable: invoices created outside a handoff flow (e.g.
// renewal invoices) do not require a handoff FK.

model Invoice {
  // Caller-assigned string id (e.g. "inv-${Date.now()}-${random}")
  id                  String    @id

  // Server-generated, globally unique, INV-XXXX format
  invoiceNumber       String    @unique

  // FK to Business (plain column, no FK constraint — matches codebase pattern)
  businessId          String

  // Denormalised for query convenience (avoids join through Business)
  clientId            String

  // Optional FK to the SalesHandoff that triggered this invoice
  salesHandoffId      String?

  // ── Financial fields ──────────────────────────────────────────────────────
  contractAmountCents Int

  setupFeeCents       Int       @default(0)
  monthlyValueCents   Int       @default(0)

  // ── Status fields (plain String — no enums in this schema) ───────────────
  // invoiceStatus vocabulary: Draft, Ready To Send, Sent, Viewed,
  //   Partially Paid, Paid, Overdue, Cancelled, Escalated
  invoiceStatus       String    @default("Draft")

  // paymentStatus vocabulary: N/A, Unpaid, Partial, Paid, Failed
  paymentStatus       String    @default("N/A")

  // ── DateTime fields (all DateTime — no String dates on Invoice) ──────────
  dueDate             DateTime
  sentAt              DateTime?
  paidAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // ── Operational fields ────────────────────────────────────────────────────
  billingOwner        String    @default("")
  archived            Boolean   @default(false)

  // Index businessId and clientId for list queries
  @@index([businessId])
  @@index([clientId])
  // Composite index supporting overdue detection:
  //   WHERE invoiceStatus IN ('Sent','Viewed','Partially Paid','Overdue')
  //     AND dueDate < now()
  // invoiceStatus first (equality/IN check narrows the set) then dueDate
  // (range scan on the filtered subset). Replaced [dueDate, paymentStatus]
  // which supported the old predicate paymentStatus != 'Paid'.
  @@index([invoiceStatus, dueDate])
  @@map("invoices")
}

// ── InvoiceSequence ───────────────────────────────────────────────────────────
// Single-row counter for globally unique, sequential invoice numbers.
//
// WHY NOT MAX(invoiceNumber): the read-then-max-then-write pattern is a
// TOCTOU race. Two simultaneous creates can both read the same max and
// produce the same next number, causing a @unique violation.
//
// THIS APPROACH: the route acquires a Postgres advisory lock (pg_try_advisory_xact_lock)
// inside a transaction, reads this row with SELECT FOR UPDATE, increments,
// writes back, then generates the INV-XXXX string. The lock guarantees
// only one concurrent writer at a time. The transaction guarantees atomicity.
//
// Seeded at 63 so the first generated number is INV-0064, clearing the
// highest mock number visible in the existing seed data (up to INV-0063).

model InvoiceSequence {
  // Single row, fixed id
  id          Int   @id @default(1)
  lastValue   Int   @default(63)

  @@map("invoice_sequence")
}
